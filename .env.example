# Rename this file to .env and fill in your real values.
# Never commit your real .env file to GitHub.

# PostgreSQL connection string.
# Local example:  postgresql://postgres:yourpassword@localhost:5432/blogspace
# Render example: comes from your Render Postgres instance's "External Database URL"
DATABASE_URL=your_postgresql_connection_string

# Port the backend server will run on
PORT=5000
